{
  "name": "@brightdata/brightdata-plugin",
  "version": "1.0.2",
  "description": "OpenClaw Bright Data plugin",
  "type": "module",
  "main": "index.ts",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "bundle": {
      "stageRuntimeDependencies": true
    },
    "compat": {
      "pluginApi": ">=2026.3.24",
      "minGatewayVersion": "2026.3.24"
    },
    "build": {
      "openclawVersion": "2026.3.28",
      "pluginSdkVersion": "2026.3.28"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "brightdata",
    "web-scraping",
    "browser-automation",
    "web-search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brightdata/openclaw-plugin.git"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.48",
    "playwright": "1.58.2"
  },
  "devDependencies": {
    "openclaw": "latest",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  }
}
